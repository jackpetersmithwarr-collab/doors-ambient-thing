local function muteGlassSounds(object)
	if object.Name == "Window" then
		for _, glass in ipairs(object:GetDescendants()) do
			if glass.Name == "Glass" then
				for _, child in ipairs(glass:GetDescendants()) do
					if child:IsA("Sound") then
						child.Volume = 0
					end
				end
			end
		end
	elseif object.Name == "Glass" and object.Parent and object.Parent.Name == "Window" then
		for _, child in ipairs(object:GetDescendants()) do
			if child:IsA("Sound") then
				child.Volume = 0
			end
		end
	end
end

for _, room in ipairs(workspace:GetDescendants()) do
	muteGlassSounds(room)
end

workspace.DescendantAdded:Connect(function(descendant)
	muteGlassSounds(descendant)
	if descendant:IsA("Sound") then
		local parent = descendant.Parent
		if parent and parent.Name == "Glass" and parent.Parent and parent.Parent.Name == "Window" then
			descendant.Volume = 0
		end
	end
end)

